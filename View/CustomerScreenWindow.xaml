<Window x:Class="Resto.Front.Api.CustomerScreen.View.CustomerScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:resources="clr-namespace:Resto.Front.Api.CustomerScreen.Resources" 
        xmlns:local="clr-namespace:Resto.Front.Api.CustomerScreen.View"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        BorderThickness="0"
        ShowActivated="False"
        x:Name="customerScreenWindow"
        Title="{x:Static resources:CustomerScreenLocalResources.WindowTitle}">

    <Window.Resources>
        <!-- Individual templates -->
        <DataTemplate x:Key="LanguageSelectorTemplate">
            <Grid>
                <!-- Background image -->
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
               Stretch="Fill"
               Panel.ZIndex="0"/>

                <!-- Overlay content -->
                <Border Background="White"
                CornerRadius="20"
                Opacity="0.9"
                Width="420"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="КАССА САМООБСЛУЖИВАНИЯ" 
                           FontSize="24"
                           FontWeight="Bold" 
                           Foreground="Black"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                        <!-- Buttons side-by-side -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Width="180" Height="40"
                                    Margin="0,0,10,0"
                                    Click="RussianLanguageButton_Click"
                                    BorderThickness="0"
                                    Background="#0078D7"
                                    Foreground="White"
                                    FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/ru.png"
               Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="РУССКИЙ ЯЗЫК" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Width="180" Height="40"
                                    Click="KazakhLanguageButton_Click"
                                    BorderThickness="0"
                                    Background="#28A745"
                                    Foreground="White"
                                    FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/kz.png"
               Width="20" Height="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="ҚАЗАҚ ТІЛІ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ScanningTemplate">
            <Grid>
                <!-- Background video placeholder -->
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
Stretch="Fill"
Panel.ZIndex="0"/>

                <Border Background="White"
                CornerRadius="20"
                Opacity="0.9"
                Width="420"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="{Binding [Scanning_Title], RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding [Scanning_Subtitle], RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="14"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>

                        <Border Background="LightGray" Height="150" Margin="0,0,0,20">
                            <TextBlock Text="Зона (видео)" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center"/>
                        </Border>

                        <Button Content="{Binding [Scanning_Button], RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="200" Height="40"
                        Background="#FF8000"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="ApiRequestButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LoadingTemplate">
            <Grid>
                <!-- Background video placeholder -->
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
                       Stretch="Fill"
                       Panel.ZIndex="0"/>
                <Border Background="White"
                        CornerRadius="20"
                        Opacity="0.9"
                        Width="420"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock  Text="{Binding [Loading], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="Black" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ErrorTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Oops! Something went wrong." Foreground="Red" FontSize="24" />
                <Button Content="Try Again" Width="200" Height="40" Click="ApiRequestButton_Click" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SuccessTemplate">
            <Grid>
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
                       Stretch="Fill"
                       Panel.ZIndex="0"/>
                <Border Background="White"
                        CornerRadius="20"
                        Opacity="0.9"
                        Width="420"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Запрос успешно выполнен!" 
                                   FontSize="24" 
                                   Foreground="Green" 
                                   Margin="0,0,0,20" 
                                   TextAlignment="Center"/>
                        <TextBlock Text="Добавленные блюда:" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="Black" 
                                   Margin="0,0,0,10" 
                                   TextAlignment="Center"/>
                        <ListBox ItemsSource="{Binding OrderDishes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                 FontSize="16" 
                                 Foreground="Black" 
                                 Margin="0,0,0,20"
                                 MaxHeight="200"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="Black" Margin="5" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Кнопки -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Повторить сканирование"
                                    Width="180" Height="40"
                                    Margin="0,0,10,0"
                                    Background="#0078D7"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="RepeatScanButton_Click"/>
                            <Button Content="Оплатить"
                                    Width="180" Height="40"
                                    Background="#28A745"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="PayButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Новый экран оплаты -->
        <DataTemplate x:Key="PaymentTemplate">
            <Grid>
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
                       Stretch="Fill"
                       Panel.ZIndex="0"/>
                <Border Background="White"
                        CornerRadius="20"
                        Opacity="0.9"
                        Width="420"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Выберите способ оплаты" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,10"
                                   TextAlignment="Center"/>
                        
                        <TextBlock Text="Блюда в заказе:" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="Black" 
                                   Margin="0,0,0,5" 
                                   TextAlignment="Center"/>
                        <ListBox ItemsSource="{Binding OrderDishes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                 FontSize="14" 
                                 Foreground="Black" 
                                 Margin="0,0,0,15"
                                 MaxHeight="150"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 BorderThickness="1"
                                 BorderBrush="LightGray">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="Black" Margin="5" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Kaspi"
                                    Width="150" Height="50"
                                    Margin="0,0,10,0"
                                    Background="#FF8000"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="KaspiButton_Click"/>

                            <Button Content="Наличные"
                                    Width="150" Height="50"
                                    Background="#0078D7"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="CashButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FinalTemplate">
            <Grid>
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
               Stretch="Fill"
               Panel.ZIndex="0"/>

                <Border Background="White"
                CornerRadius="20"
                Opacity="0.9"
                Width="420"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Спасибо за оплату!" 
                           FontSize="26" 
                           FontWeight="Bold" 
                           Foreground="Green" 
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <local:ScreenTemplateSelector x:Key="ScreenSelector"
                                      LanguageSelectorTemplate="{StaticResource LanguageSelectorTemplate}"
                                      ScanningTemplate="{StaticResource ScanningTemplate}"
                                      LoadingTemplate="{StaticResource LoadingTemplate}"
                                      ErrorTemplate="{StaticResource ErrorTemplate}"
                                      SuccessTemplate="{StaticResource SuccessTemplate}"
                                      PaymentTemplate="{StaticResource PaymentTemplate}" 
                                      FinalTemplate="{StaticResource FinalTemplate}"
                                    />
    </Window.Resources>

    <Grid Background="Yellow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="31*"/>
            <ColumnDefinition Width="72*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <ContentControl Content="{Binding CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}}"
                        ContentTemplateSelector="{StaticResource ScreenSelector}" Grid.ColumnSpan="4" />
    </Grid>
</Window>
