    <Grid Background="Black">
        <ContentControl>
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentScreen}" Value="Welcome">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Welcome to Our Restaurant" FontSize="24" Foreground="White" TextAlignment="Center"/>
                                        <TextBlock Text="Please wait while your order is being prepared..." FontSize="16" Foreground="LightGray" TextAlignment="Center"/>
                                        <Button Content="Next" Width="200" Height="40"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
   
