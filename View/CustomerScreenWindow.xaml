<Window x:Class="Resto.Front.Api.CustomerScreen.View.CustomerScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:resources="clr-namespace:Resto.Front.Api.CustomerScreen.Resources" 
        xmlns:local="clr-namespace:Resto.Front.Api.CustomerScreen.View"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        BorderThickness="0"
        ShowActivated="False"
        x:Name="customerScreenWindow"
        Title="{x:Static resources:CustomerScreenLocalResources.WindowTitle}">

    <Window.Resources>
        <!-- Individual templates -->
        <DataTemplate x:Key="LanguageSelectorTemplate">
            <Grid>
                <!-- Background image -->
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
               Stretch="Fill"
               Panel.ZIndex="0"/>

                <!-- Overlay content -->
                <Border Background="White"
                CornerRadius="60"
                Opacity="0.9"
                Width="1260"
                Padding="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="КАССА САМООБСЛУЖИВАНИЯ" 
                           FontSize="72"
                           FontWeight="Bold" 
                           Foreground="Black"
                           TextAlignment="Center"
                           Margin="0,0,0,60"/>

                        <!-- Buttons side-by-side -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Width="540" Height="120"
                                    Margin="0,0,30,0"
                                    Click="RussianLanguageButton_Click"
                                    BorderThickness="0"
                                    Background="#0078D7"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="36">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/ru.png"
               Width="60" Height="60" Margin="0,0,24,0"/>
                                    <TextBlock Text="РУССКИЙ ЯЗЫК" VerticalAlignment="Center" FontSize="36"/>
                                </StackPanel>
                            </Button>

                            <Button Width="540" Height="120"
                                    Click="KazakhLanguageButton_Click"
                                    BorderThickness="0"
                                    Background="#28A745"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="36">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/kz.png"
               Width="60" Height="60" Margin="0,0,24,0"/>
                                    <TextBlock Text="ҚАЗАҚ ТІЛІ" VerticalAlignment="Center" FontSize="36"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ScanningTemplate">
            <Grid>
                <!-- Background video placeholder -->
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
Stretch="Fill"
Panel.ZIndex="0"/>

                <Border Background="White"
                CornerRadius="60"
                Opacity="0.9"
                Width="1260"
                Padding="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <StackPanel>
                        <TextBlock Text="{Binding [Scanning_Title], RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="60"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,0,0,30"/>

                        <TextBlock Text="{Binding [Scanning_Subtitle], RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="42"
                           TextAlignment="Center"
                           Margin="0,0,0,60"/>

						<Border Background="LightGray" Height="450" Margin="0,0,0,60">
							<Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/correct_scan.jpg"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
						</Border>

						<Button Content="{Binding [Scanning_Button], RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="600" Height="120"
                        Background="#FF8000"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="36"
                        Click="ApiRequestButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LoadingTemplate">
            <Grid>
                <!-- Background video placeholder -->
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
                       Stretch="Fill"
                       Panel.ZIndex="0"/>
                <Border Background="White"
                        CornerRadius="60"
                        Opacity="0.9"
                        Width="1260"
                        Padding="60"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock  Text="{Binding [Loading], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="Black" FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ErrorTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding [Error_Title], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="Red" FontSize="72" Margin="0,0,0,60" />
                <Button Content="{Binding [Button], RelativeSource={RelativeSource AncestorType=Window}}" Width="600" Height="120" FontSize="36" Click="ApiRequestButton_Click" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SuccessTemplate">
            <Grid>
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
                       Stretch="Fill"
                       Panel.ZIndex="0"/>
                <Border Background="White"
                        CornerRadius="60"
                        Opacity="0.9"
                        Width="1260"
                        Padding="60"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Success_Title], RelativeSource={RelativeSource AncestorType=Window}}" 
                                   FontSize="72" 
                                   Foreground="Green" 
                                   Margin="0,0,0,60" 
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding [Success_AddedDishes], RelativeSource={RelativeSource AncestorType=Window}}" 
                                   FontSize="54" 
                                   FontWeight="Bold"
                                   Foreground="Black" 
                                   Margin="0,0,0,30" 
                                   TextAlignment="Center"/>
                        <ListBox ItemsSource="{Binding OrderDishes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                 FontSize="48" 
                                 Foreground="Black" 
                                 Margin="0,0,0,60"
                                 MaxHeight="600"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="Black" Margin="15" FontSize="48" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Кнопки -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{Binding [Repeat_Scan], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="540" Height="120"
                                    Margin="0,0,30,0"
                                    Background="#0078D7"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="36"
                                    Click="RepeatScanButton_Click"/>
                            <Button Content="{Binding [Pay], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="540" Height="120"
                                    Background="#28A745"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="36"
                                    Click="PayButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Новый экран оплаты -->
        <DataTemplate x:Key="PaymentTemplate">
            <Grid>
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
                       Stretch="Fill"
                       Panel.ZIndex="0"/>
                <Border Background="White"
                        CornerRadius="60"
                        Opacity="0.9"
                        Width="1260"
                        Padding="60"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Payment_Title], RelativeSource={RelativeSource AncestorType=Window}}" 
                                   FontSize="66" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,30"
                                   TextAlignment="Center"/>
                        
                        <TextBlock Text="{Binding [Payment_Dishes], RelativeSource={RelativeSource AncestorType=Window}}" 
                                   FontSize="48" 
                                   FontWeight="Bold"
                                   Foreground="Black" 
                                   Margin="0,0,0,15" 
                                   TextAlignment="Center"/>
                        <ListBox ItemsSource="{Binding OrderDishes, RelativeSource={RelativeSource AncestorType=Window}}" 
                                 FontSize="42" 
                                 Foreground="Black" 
                                 Margin="0,0,0,45"
                                 MaxHeight="450"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 BorderThickness="3"
                                 BorderBrush="LightGray">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="Black" Margin="15" FontSize="42" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Kaspi"
                                    Width="450" Height="150"
                                    Margin="0,0,30,0"
                                    Background="#FF8000"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="36"
                                    Click="KaspiButton_Click"/>

                            <Button Content="{Binding [Payment_Cash], RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="450" Height="150"
                                    Background="#0078D7"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="36"
                                    Click="CashButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FinalTemplate">
            <Grid>
                <Image Source="/Resto.Front.Api.CustomerScreen;component/Resources/canteen.jpg"
               Stretch="Fill"
               Panel.ZIndex="0"/>

                <Border Background="White"
                CornerRadius="60"
                Opacity="0.9"
                Width="1260"
                Padding="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Thanks], RelativeSource={RelativeSource AncestorType=Window}}" 
                           FontSize="78" 
                           FontWeight="Bold" 
                           Foreground="Green" 
                           TextAlignment="Center"
                           Margin="0,0,0,30"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <local:ScreenTemplateSelector x:Key="ScreenSelector"
                                      LanguageSelectorTemplate="{StaticResource LanguageSelectorTemplate}"
                                      ScanningTemplate="{StaticResource ScanningTemplate}"
                                      LoadingTemplate="{StaticResource LoadingTemplate}"
                                      ErrorTemplate="{StaticResource ErrorTemplate}"
                                      SuccessTemplate="{StaticResource SuccessTemplate}"
                                      PaymentTemplate="{StaticResource PaymentTemplate}" 
                                      FinalTemplate="{StaticResource FinalTemplate}"
                                    />
    </Window.Resources>

    <Grid Background="Yellow">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="31*"/>
            <ColumnDefinition Width="72*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <ContentControl Content="{Binding CurrentScreen, RelativeSource={RelativeSource AncestorType=Window}}"
                        ContentTemplateSelector="{StaticResource ScreenSelector}" Grid.ColumnSpan="4" />
    </Grid>
</Window>
